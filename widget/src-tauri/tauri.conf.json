{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAVRYX SKY Widget",
  "version": "1.0.0",
  "identifier": "ua.navryx.sky.widget",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NAVRYX SKY",
        "url": "https://sky.navryx.com.ua/?mini=1&app=widget",
        "width": 400,
        "height": 320,
        "minWidth": 300,
        "minHeight": 200,
        "alwaysOnTop": true,
        "resizable": true,
        "center": false,
        "x": 40,
        "y": 40,
        "backgroundColor": "#07090E",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NAVRYX",
    "shortDescription": "Повітряна обстановка поверх усіх вікон",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
